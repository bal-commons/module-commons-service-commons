{
  "name": "@bal-commons/ui-core",
  "version": "0.1.0",
  "description": "Shared plumbing for the bal-commons UI components: auth adapters, service calls, live SSE streams and theme tokens.",
  "license": "Apache-2.0",
  "author": "Hasitha Aravinda",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bal-commons/module-commons-service-commons.git",
    "directory": "ui"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "lit": "^3.3.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  }
}
